---
import Header from '../ui/Header.astro';
import Footer from '../ui/Footer.astro';
import { Toaster } from 'sonner';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'QUEUE 6 - ระบบจัดการคิว' } = Astro.props;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="ระบบบริหารจัดการคิวและข้อมูลผู้ใช้งาน" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="layout-container">
      <Header />
      <main class="app-main">
        <div class="main-content">
          <slot />
        </div>
      </main>
      <Footer />
    </div>
    <Toaster client:only="react" position="top-right" richColors theme="dark" closeButton />
  </body>
</html>
