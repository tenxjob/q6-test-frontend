# Backend API Base URL for Production (e.g. https://your-backend.onrender.com or http://localhost:3000)
PUBLIC_API_BASE_URL=http://localhost:3000

# WebSocket Base URL for Production (e.g. wss://your-backend.onrender.com/ws or ws://localhost:3000/ws)
# If omitted, it will automatically default to converting PUBLIC_API_BASE_URL to ws:// or wss://
PUBLIC_WS_URL=ws://localhost:3000/ws
